# MongoDB connection string (MongoDB Atlas free tier recommended, since no local mongod is required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blinkride

# Port the Express API listens on
PORT=4000

# SMTP credentials used to email a notification whenever a booking or contact form is submitted.
# Leave blank to skip email sending. Submissions are still saved to MongoDB either way.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=support@blinkride.com

# Optional BCC recipients for every notification email. Comma-separate multiple addresses.
NOTIFY_BCC=etech.abdulrehman@gmail.com
